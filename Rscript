# 5.5. Foraging SBFI ------------------------------------------------------
ICISBFI <- ICI
ICISBFI <- ICISBFI %>%
  arrange(ChunkEnd, Station, POD) %>%
  group_by(ChunkEnd, Station, POD) %>%
  mutate(
    buzz_click = ICIms >= 1.25 & ICIms <= 6.65,
    
    # search_before_buzz using coin-flip method (TRUE for all rows with Clicks.s < 200)
    search_before_buzz = {
      sb <- rep(FALSE, n())
      r <- rle(buzz_click) 
      start <- cumsum(c(1, head(r$lengths, -1))) # positions of when every new buzz (false or true) starts
      end   <- cumsum(r$lengths) # end position is the same as how many T or F are counted
      
      for(i in which(r$values)) {
        buzz_start <- start[i] 
        if(buzz_start > 1) { # buzz cannot be at position one of the minute because then there can be no search before
          potential_search_rows <- 1:(buzz_start - 1)
          sb[potential_search_rows] <- Clicks.s[potential_search_rows] < 200 | sb[potential_search_rows]
          }}
      sb
      },
    
    # longest count of TRUE buzz clicks in the whole minute 
    max_buzz_run = {
      r <- rle(buzz_click)
      if(any(r$values)) max(r$lengths[r$values]) else 0
    },
    
    # Buzz click if buzz and search before buzz present 
    Nb = as.integer(max_buzz_run >= 3 & any(search_before_buzz))
  ) %>%
  ungroup()

