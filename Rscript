exp(0.757768) #2.13 ms in pirotta this is 2.13ms 16.21 and 39.19

lambda <- mixmod$lambda
mu <- mixmod$mu
sigma <- mixmod$sigma

# Create a function to assign types based on the densities
assign_type <- function(value) {
  densities <- sapply(1:3, function(i) {
    lambda[i] * dnorm(value, mean = mu[i], sd = sigma[i])})
  type <- which.max(densities)
  if (type == 1) {
    return("buzz")
  } else if (type == 2) {
    return("regular")
  } else {
    return("long")
  }
}

